{
  "name": "wintercamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Winter Camp 2027 website for Kid's Happy Club",
  "scripts": {
    "gallery": "node scripts/build-gallery.mjs",
    "pages": "node scripts/render-pages.mjs",
    "prepare-site": "npm run gallery && npm run pages",
    "dev": "npm run gallery && node scripts/render-pages.mjs --dev && vite",
    "build": "npm run prepare-site && vite build",
    "preview": "vite preview",
    "mock-backend": "node scripts/mock-backend.mjs",
    "test": "node --test tests/backend.test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/jomolhari": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.187.0"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
